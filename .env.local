SHORTNER.ENV='local'

# Infrastructure
SHORTNER.INFRASTRUCTURE.POSTGRES.HOST=localhost
SHORTNER.INFRASTRUCTURE.POSTGRES.PORT=5432
SHORTNER.INFRASTRUCTURE.POSTGRES.USERNAME=admin
SHORTNER.INFRASTRUCTURE.POSTGRES.PASSWORD=admin
SHORTNER.INFRASTRUCTURE.POSTGRES.DATABASE=auth
SHORTNER.INFRASTRUCTURE.POSTGRES.MAX_OPEN_CONNECTIONS=16
SHORTNER.INFRASTRUCTURE.POSTGRES.MAX_IDEL_CONNECTIONS=16
SHORTNER.INFRASTRUCTURE.POSTGRES.MAX_IDEL_TIME=1m
SHORTNER.INFRASTRUCTURE.POSTGRES.SSL_MODE=disable

SHORTNER.INFRASTRUCTURE.CASSANDRA.HOST=localhost
SHORTNER.INFRASTRUCTURE.CASSANDRA.PORT=9042
SHORTNER.INFRASTRUCTURE.CASSANDRA.keyspace=shortner
SHORTNER.INFRASTRUCTURE.CASSANDRA.USERNAME=cassandra
SHORTNER.INFRASTRUCTURE.CASSANDRA.PASSWORD=cassandra

SHORTNER.INFRASTRUCTURE.CLICKHOUSE.HOST=localhost
SHORTNER.INFRASTRUCTURE.CLICKHOUSE.PORT=9000
SHORTNER.INFRASTRUCTURE.CLICKHOUSE.DATABASE=default
SHORTNER.INFRASTRUCTURE.CLICKHOUSE.USERNAME=admin
SHORTNER.INFRASTRUCTURE.CLICKHOUSE.PASSWORD=admin

SHORTNER.INFRASTRUCTURE.REDIS.HOST=localhost
SHORTNER.INFRASTRUCTURE.REDIS.PORT=6379
SHORTNER.INFRASTRUCTURE.REDIS.USERNAME=admin
SHORTNER.INFRASTRUCTURE.REDIS.PASSWORD=admin
SHORTNER.INFRASTRUCTURE.REDIS.DATABASE=0

SHORTNER.INFRASTRUCTURE.REDIS_ANALYTICS.HOST=localhost
SHORTNER.INFRASTRUCTURE.REDIS_ANALYTICS.PORT=6380
SHORTNER.INFRASTRUCTURE.REDIS_ANALYTICS.USERNAME=admin
SHORTNER.INFRASTRUCTURE.REDIS_ANALYTICS.PASSWORD=admin
SHORTNER.INFRASTRUCTURE.REDIS_ANALYTICS.DATABASE=0

SHORTNER.INFRASTRUCTURE.KAFKA.HOST=localhost
SHORTNER.INFRASTRUCTURE.KAFKA.PORT=9094
SHORTNER.INFRASTRUCTURE.KAFKA.USERNAME=admin
SHORTNER.INFRASTRUCTURE.KAFKA.PASSWORD=admin

# Mailer
SHORTNER.MAILER.FROM=shortner@example.com
SHORTNER.MAILER.HOST=localhost
SHORTNER.MAILER.PORT=1025
SHORTNER.MAILER.USERNAME=superuser
SHORTNER.MAILER.PASSWORD=secretpass

# Auth
SHORTNER.AUTH.SECRET=SECRET_KEY
SHORTNER.AUTH.TOKEN_EXPIRES_AFTER=1h

# Tokens
SHORTNER.TOKENS.USER_VERIFICATION.SECRET=SECRET_KEY
SHORTNER.TOKENS.USER_PASSWORD_RESET.SECRET=SECRET_KEY

# Tracing
SHORTNER.OBSERVABILITY.TRACING.ENABLED=true
SHORTNER.OBSERVABILITY.TRACING.ENDPOINT='localhost:4314'
SHORTNER.OBSERVABILITY.TRACING.SAMPLE_RATE=1.0

# Metrics
SHORTNER.OBSERVABILITY.METRICS.ENABLED=true
SHORTNER.OBSERVABILITY.METRICS.ENDPOINT='localhost:4317'
SHORTNER.OBSERVABILITY.METRICS.RUNTIME=true
SHORTNER.OBSERVABILITY.METRICS.REQUESTS=true